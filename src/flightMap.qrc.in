<!DOCTYPE RCC><RCC version="1.0">
    <qresource>
        <!-- MapBox style files -->
        <file alias="flightMap/empty.json">${CMAKE_CURRENT_SOURCE_DIR}/flightMap/empty.json</file>
        <file alias="flightMap/osm-liberty.json">${CMAKE_CURRENT_SOURCE_DIR}/flightMap/osm-liberty.json</file>
        <file alias="flightMap/osm-liberty-dark.json">${CMAKE_CURRENT_SOURCE_DIR}/flightMap/osm-liberty-dark.json</file>

	<!-- Aviation overlay layers, generated from FlightMap.qml. See
	     generatedSources/generateAviationLayers.py. Used when serving the map
	     to a companion device, which renders it without the app's QML. -->
	<file alias="flightMap/aviation-layers.json">${CMAKE_SOURCE_DIR}/generatedSources/flightMap/aviation-layers.json</file>

	<!-- Sprites -->
	<file alias="flightMap/sprites/sprite.json">${CMAKE_SOURCE_DIR}/generatedSources/flightMap/sprite.json</file>
	<file alias="flightMap/sprites/sprite@2x.json">${CMAKE_SOURCE_DIR}/generatedSources/flightMap/sprite@2x.json</file>
	<file alias="flightMap/sprites/sprite.png">${CMAKE_SOURCE_DIR}/generatedSources/flightMap/sprite.png</file>
	<file alias="flightMap/sprites/sprite@2x.png">${CMAKE_SOURCE_DIR}/generatedSources/flightMap/sprite@2x.png</file>
    </qresource>
</RCC>
