# The wrapper script is executed by /bin/sh on Linux CI. If it were ever checked out
# with CRLF endings it would fail with "bad interpreter", so pin it.
gradlew            text eol=lf
*.kts              text eol=lf
*.kt               text eol=lf
*.toml             text eol=lf
*.pro              text eol=lf
gradlew.bat        text eol=crlf
gradle-wrapper.jar binary
