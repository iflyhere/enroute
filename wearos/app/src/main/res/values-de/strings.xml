    <string name="settings_charts">Anflugkarten</string>
    <string name="settings_charts_note">Automatisch legt die Karte, die das Flugzeug abdeckt, auf die Karte — so, wie das Telefon eine auswählt. Karten werden auf dem Telefon importiert.</string>
