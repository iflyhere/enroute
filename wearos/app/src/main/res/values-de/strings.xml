    <string name="settings_bezel_note">Zoomen auf der Karte geht auch durch Ziehen nach oben und unten, unabhängig von dieser Wahl.</string>
    <string name="settings_screens">Seiten</string>
    <string name="settings_screens_pinned">fest</string>
    <string name="settings_link">Verbindung</string>
    <string name="settings_link_note">WLAN braucht beide Geräte im selben Netz und ist viel schneller. Bluetooth braucht gar kein Netz, und das ist es, was es in den meisten Flugzeugen gibt. Automatisch versucht beides.</string>
