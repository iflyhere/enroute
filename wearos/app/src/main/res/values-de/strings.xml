    <string name="settings_display">Anzeige</string>
    <string name="settings_display_always_on">Immer an</string>
    <string name="settings_display_normal">Normal</string>
    <string name="settings_display_note">Immer an ist das, was dies im Flug lesbar macht: eine Uhr kehrt nach Sekunden ohne Berührung zum Zifferblatt zurück, und Hände an den Rudern berühren nichts. Es ist auch der größte Batterieposten dieser App.</string>
