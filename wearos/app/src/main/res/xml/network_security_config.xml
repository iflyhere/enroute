<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 1 of the companion protocol is plain HTTP on a local network, so cleartext has
  to be permitted: Android blocks it by default for targetSdk 28 and above.

  This is a deliberate trade-off rather than an oversight. The phone is not a public
  server and has no certificate, and asking a pilot to install one on a watch is not a
  realistic option. What protects the link instead is that the feature is off by default
  on the phone, that every request must carry a pairing code, and that the phone refuses
  requests from anything other than a loopback, private-use or link-local address.

  Stage 2 of the protocol carries the same documents over Bluetooth Low Energy with
  encrypted characteristics, and needs no cleartext exemption at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
